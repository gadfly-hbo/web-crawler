{
  "name": "workbench",
  "version": "0.1.0",
  "private": true,
  "description": "数据采集工作台：面向非技术运营的本机 Web 界面",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.7",
    "hono": "^4.10.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.1"
  }
}
